{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh workflow run:*)"
    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ]
  }
}

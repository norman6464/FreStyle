# =========================
# データベース
# =========================
# ローカル開発はリポジトリ直下の docker-compose.yml の PostgreSQL を使う (推奨)。
#   docker compose up -d   … DB + メールキャッチャー + バックエンド(Go) が起動する
# その場合の DATABASE_URL は次の 1 行でよい (コメントを外す):
# DATABASE_URL=postgres://frestyle:frestyle@localhost:5432/frestyle?sslmode=disable
#
# ここに書くのは「ホストから見た」接続先(localhost)。このファイルは backend コンテナにも
# 渡すが、コンテナから見た宛先は異なるため DATABASE_URL と MAIL_SMTP_HOST の 2 つだけ
# compose 側でサービス名(db / mail)に上書きしている。
#
# 本番 / staging は Supabase Transaction pooler URL を使う (2026-05 RDS から移行完了)。
# 例: postgresql://postgres.xxxxx:PASSWORD@aws-N-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# - aws-N の N は Supabase project の クラスタ番号
# - pgbouncer=true は付けない (libpq 18 で接続拒否される / host 名で backend が pgbouncer を自動判定)
# DATABASE_URL がセットされていると DB_HOST 等は無視される。
DATABASE_URL=

# 個別 設定 (DATABASE_URL 未 設定 時 の フォールバック / ローカル の docker postgres など)。
# 通常は DATABASE_URL を使うため不要。
#
# DB_SSLMODE の値:
#   - require  : 本番 / staging で 旧 RDS 等 の TLS 必須 DB に つなぐ場合
#   - disable  : ローカル docker postgres など TLS 設定 が ない DB の場合
#   未指定なら backend (config.go) の getEnvOrDefault で "require" になるので、
#   ローカル docker 利用時は明示的に DB_SSLMODE=disable に書き換えること。
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=fre_style
DB_SSLMODE=disable

# 実行環境。local 以外だと gin が release モードになり、ログも Info 以上に絞られる。
#
# **local だからといって認証が緩むことは無い。** 以前は「JWKS が無く APP_ENV が local なら
# 署名検証をしない」逃げ道があり、APP_ENV は未設定でも local に解決されたため、
# 環境変数を入れ忘れた環境がそのまま素通しで動き得た。いまは設定が欠けていれば起動を止める。
APP_ENV=local

# ===== 認証（OpenID Connect）=====
#
# 値は実際に使う発行者（IdP）の管理画面 / セットアップ手順から得て貼る。
#
# **どれかが空だと backend は起動しない。** 認証の設定は「揃っているか、いないか」の
# どちらかにしてある。中途半端に動くと、検証していないことに誰も気づけない。

# トークンの iss と完全一致させる文字列。ブラウザが見る URL と同じでなければならない。
# JWKS の URL から推測しないこと（発行者を替えた瞬間に全員 401 になる）。
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_TOKEN_URI=
# ログアウトで発行者側のセッションも終わらせる先。空だと、Cookie を消しても
# 発行者側にログイン済みが残り、同じ端末で入り直せてしまう。
OIDC_END_SESSION_URI=
OIDC_CLIENT_ID=
# ログイン後の戻り先。フロントの実ルート（frontend/src/app/App.tsx の
# <Route path="/login/callback">）と完全に一致させる。ずれると、発行者は
# redirect_uri_mismatch で交換を拒む。
OIDC_REDIRECT_URI=http://localhost:5173/login/callback
# 公開クライアント（PKCE）なら空のまま。ブラウザで動くアプリは秘密を持てない。
OIDC_CLIENT_SECRET=

# access_token の aud に含まれていることを要求する値（カンマ区切り）。
# 空なら OIDC_CLIENT_ID を要求する。発行者が aud にプロジェクトの識別子を入れる構成では
# その値をここに足す。
OIDC_AUDIENCES=

# 役割の在り処。発行者ごとに違うので、実際に使う発行者の形に合わせて指定する。
# 未設定時の既定値は "roles"（どの発行者にも当てはまる値ではないので、実運用では必ず指定する）。
OIDC_ROLES_CLAIM=
OIDC_ADMIN_ROLE=admin

# 「最初の運営管理者」だけを招待なしで受け入れるブートストラップ用アドレス。
# 通常は空にする（空なら招待免除は一切効かない）。
# 招待は FreStyle 唯一のアカウント発行統制なので、発行者側で管理者の役割を持っている
# だけでは招待を迂回できない。ただし super_admin が 1 人も居ない新環境では、招待を作れる人が
# 誰も居らず詰むため、次の 3 つが揃ったときだけ招待なしのサインアップを許す:
#   1. ここに設定したアドレスとログインする email が一致する
#   2. そのユーザーが発行者側で管理者の役割（OIDC_ADMIN_ROLE）を持っている
#   3. まだ super_admin が 1 人も存在しない
# 3 により最初の 1 人ができた時点でこの経路は自動的に閉じる（判定と作成は同一トランザクション
# で行うため、同時にログインしても 2 人目は作られない）。作成後はこの環境変数を外すこと。
# 突き合わせは前後の空白を落として小文字化した値どうしで行う（大小文字の違いは同じアドレス）。
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# AWS
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_REGION=ap-northeast-1

# S3 ノート画像
NOTE_IMAGES_BUCKET=your-note-images-bucket-name
NOTE_IMAGES_CDN_URL=https://your-cloudfront-domain.cloudfront.net

# AWS SES — 招待マジックリンクメール送信
# 本番ではドメイン検証済の送信元を指定（"FreStyle <noreply@normanblog.com>" 形式可）
# 未設定（空）のときは送信スキップ → token をログ出力するフォールバックモードになる
SES_REGION=ap-northeast-1
SES_FROM_ADDRESS=

# SES を使わない環境(staging / local)向けの SMTP 送信設定。
# MAIL_SMTP_HOST を設定すると SES より優先して SMTP で送信する(メールキャッチャー宛・認証/TLS なし)。
# local はリポジトリ直下の docker compose up でキャッチャーが起動する。
# MAIL_SMTP_HOST=localhost を設定し、受信メールは http://localhost:8025 で閲覧する。
# staging は box の edge スタックが常駐させる。
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=1025
MAIL_FROM_ADDRESS=

# 招待マジックリンクの組み立てに使うフロントエンドの絶対 URL
# 例: https://normanblog.com  /  http://localhost:5173
APP_BASE_URL=http://localhost:5173

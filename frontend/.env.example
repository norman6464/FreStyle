# frontend のビルド時設定。`cp .env.example .env` して使う。
#
# VITE_ で始まる値は **バンドルに焼き込まれて公開される**。秘密は置かない。
# ログインで秘密を持たないのは仕様どおりで、ブラウザで動くアプリは秘密を隠せないため、
# 代わりに PKCE（毎回作って 1 回だけ使う検証値）で「認可を始めた本人か」を示す。

# API の基点。空なら同一オリジンの相対パス（手元の Vite は proxy 経由で backend へ）。
VITE_API_BASE_URL=

# ===== 認証（OpenID Connect / 手元は Zitadel）=====
#
# 値は `./backend/scripts/zitadel-setup.sh` の出力から貼る。

# ログイン画面へ送る認可要求の宛先。**ブラウザから届く URL** であること。
VITE_OIDC_AUTHORIZE_URI=http://zitadel.localhost:8081/oauth/v2/authorize
VITE_OIDC_CLIENT_ID=

# ログイン後の戻り先。backend の OIDC_REDIRECT_URI と、発行者に登録した値の
# 3 つすべてが一致していること。1 つでもずれると redirect_uri_mismatch で止まる。
VITE_OIDC_REDIRECT_URI=http://localhost:5173/login/callback

# ログアウトで発行者側のセッションも終わらせる先。
# 空だと、Cookie を消しても発行者側にログイン済みが残り、同じ端末で入り直せてしまう。
VITE_OIDC_END_SESSION_URI=http://zitadel.localhost:8081/oidc/v1/end_session

# 要求する範囲（空白区切り）。
# openid だけだと id_token に名前もメールも載らず、offline_access が無いと
# 更新用のトークンがそもそも発行されない（アクセストークンが切れた瞬間に
# 全員ログイン画面へ飛ぶ）。省略時もこの 4 つを既定にしてある。
VITE_OIDC_SCOPE=openid profile email offline_access

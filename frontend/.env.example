# frontend のビルド時設定。`cp .env.example .env` して使う。
#
# VITE_ で始まる値は **バンドルに焼き込まれて公開される**。秘密は置かない。
# ログインで秘密を持たないのは仕様どおりで、ブラウザで動くアプリは秘密を隠せないため、
# 代わりに PKCE（毎回作って 1 回だけ使う検証値）で「認可を始めた本人か」を示す。

# API の基点。**vite.config.js に server.proxy は無く、フロントと backend は別オリジン
# 構成**（frontend は :5173、backend は :8080）。空にすると同一オリジン相対パスになり、
# ローカルではフロントのオリジンにしか届かず backend に繋がらないため、ローカル開発では
# 必ず backend の絶対 URL を指定する。
VITE_API_BASE_URL=http://localhost:8080

# ===== 認証 =====
#
# 発行者が 2 通りある。**両方を同時に埋めない** — resolveAuthMode() は Firebase を
# 優先するため、Dex 向けの値を埋めていても Firebase が設定されていれば無視される。
# ローカル開発は下の「Dex」節だけを埋め、「Firebase」節は空のままにする。

# ----- Firebase（GCIP・本番向け）-----
#
# Google Cloud Identity Platform（Firebase Authentication と同じ API/SDK）。
# frontend/src/features/auth/model/useFirebaseAuth.ts が signInWithEmailAndPassword /
# signInWithPopup(Google) 等でその場でサインイン・サインアップを完結させる。
# 値は Firebase コンソール（プロジェクト設定 → 全般 → マイアプリ → SDK の設定と構成）から
# 得る。ローカル開発では使わないため、通常は空のままでよい。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# ----- Dex（ローカル開発向け・OpenID Connect）-----
#
# リポジトリ直下の docker-compose.yml が起動する OSS の Dex（docker/idp/config.yaml）。
# 固定 1 アカウント（admin@example.com / password）のみで、自己登録・パスワード再設定は
# 無い。backend は認可コード交換を仲介しない（Bearer の ID トークン検証だけを行う）ため、
# フロントエンドがブラウザから直接 Dex の /dex/token を叩いてトークンに交換する
# （features/auth 経由で shared/lib/auth/oidcAuthUrl.ts の exchangeCodeForToken を呼ぶ）。

# ログイン画面へ送る認可要求の宛先。**ブラウザから届く URL** であること。
# ローカルの Dex はホストから http://localhost:5556/dex で見える
# （docker-compose.yml の idp サービス。ポート 5556 は固定 — ずらすと Dex の
# issuer 文字列・backend の OIDC_JWKS_URI ともずれて全員 401 になる）。
VITE_OIDC_AUTHORIZE_URI=http://localhost:5556/dex/auth

# トークン交換の宛先（ブラウザから直接叩く）。ポートが上と揃っていること。
VITE_OIDC_TOKEN_URI=http://localhost:5556/dex/token

VITE_OIDC_CLIENT_ID=frestyle-local

# ログイン後の戻り先。docker/idp/config.yaml の staticClients.redirectURIs と
# 一致していること。ずれると redirect_uri_mismatch で止まる。
VITE_OIDC_REDIRECT_URI=http://localhost:5173/login/callback

# 要求する範囲（空白区切り）。
# openid だけだと id_token に名前もメールも載らず、offline_access が無いと
# 更新用のトークンがそもそも発行されない（アクセストークンが切れた瞬間に
# 全員ログイン画面へ飛ぶ）。
VITE_OIDC_SCOPE="openid profile email offline_access"

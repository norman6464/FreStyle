{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/*.{test,spec}.{ts,tsx}",
    "e2e/**/*.{ts,tsx}",
    "src/shared/ui/RichTextEditor/index.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/generated/**"],
  "ignoreDependencies": ["@stryker-mutator/api"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "off",
    "nsExports": "off",
    "types": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "duplicates": "off"
  }
}

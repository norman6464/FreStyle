{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:local": "playwright test --config=playwright.local.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "tailwind:init": "tailwindcss init -p",
    "openapi:generate": "swagger2openapi ../backend/docs/swagger.json --outfile src/generated/openapi.json && openapi-typescript src/generated/openapi.json --output src/generated/api.ts",
    "knip": "knip",
    "md2doc": "tsx scripts/md2doc.mjs",
    "size": "npm run build && size-limit",
    "prerender": "node scripts/prerender.mjs"
  },
  "overrides": {
    "form-data": "^4.0.6"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@heroicons/react": "^2.2.0",
    "@reduxjs/toolkit": "^2.9.0",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-code": "^3.30.2",
    "@tiptap/extension-code-block-lowlight": "^3.30.2",
    "@tiptap/extension-heading": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-list": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extensions": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@tiptap/suggestion": "^3.30.2",
    "axios": "^1.18.1",
    "github-slugger": "^2.0.0",
    "lowlight": "^3.3.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@size-limit/file": "~12.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/markdown": "^3.30.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^28.0.0",
    "knip": "^6.29.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "size-limit": "~12.1.0",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
